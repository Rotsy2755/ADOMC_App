{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — ADOMC{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="dashboard-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label mb-1">Projets actifs</div>
                    <div class="stat-value">{{ counts.projects }}</div>
                </div>
                <div class="icon-btn" style="background: rgba(59,130,246,0.15); color: var(--accent-blue);">
                    <i class="fas fa-folder-tree"></i>
                </div>
            </div>
            <div class="stat-change positive"><i class="fas fa-check"></i> Gérés par vous</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="dashboard-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label mb-1">Problèmes MOKP</div>
                    <div class="stat-value">{{ counts.problems }}</div>
                </div>
                <div class="icon-btn" style="background: rgba(16,185,129,0.15); color: var(--accent-success);">
                    <i class="fas fa-puzzle-piece"></i>
                </div>
            </div>
            <div class="stat-change positive"><i class="fas fa-bezier-curve"></i> {{ counts.paretoReady }} fronts Pareto prêts</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="dashboard-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label mb-1">Calculs MCDM</div>
                    <div class="stat-value" style="color: var(--accent-purple);">{{ counts.mcdmRuns }}</div>
                </div>
                <div class="icon-btn" style="background: rgba(139,92,246,0.15); color: var(--accent-purple);">
                    <i class="fas fa-layer-group"></i>
                </div>
            </div>
            <div class="stat-change positive"><i class="fas fa-chart-line"></i> TOPSIS / VIKOR / PROMETHEE II / ELECTRE I</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="dashboard-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label mb-1">Front de Pareto</div>
                    <div class="stat-value" style="color: var(--accent-cyan);">{{ counts.paretoReady }}</div>
                </div>
                <div class="icon-btn" style="background: rgba(6,182,212,0.15); color: var(--accent-cyan);">
                    <i class="fas fa-bezier-curve"></i>
                </div>
            </div>
            <div class="stat-change positive"><i class="fas fa-bolt"></i> ε-contrainte / NSGA-II</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="dashboard-card" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%); position: relative; overflow: hidden;">
            <div style="position: relative; z-index: 1;">
                <h4 class="mb-2">Bienvenue {{ app.user.fullName }}</h4>
                <p class="text-secondary mb-4">
                    Aide à la Décision Multi-Objectifs et Multi-Critères :
                    MOKP, AHP, TOPSIS/VIKOR/PROMETHEE II/ELECTRE I, sensibilité et robustesse.
                </p>
                <a href="{{ path('app_project_new') }}" class="btn btn-primary mb-2 w-100"><i class="fas fa-plus"></i> Nouveau projet</a>
                <a href="{{ path('app_problem_new') }}" class="btn btn-outline w-100"><i class="fas fa-puzzle-piece"></i> Nouveau problème MOKP</a>
            </div>
            <div style="position: absolute; right: -20px; bottom: -20px; opacity: 0.1; font-size: 150px;">
                <i class="fas fa-project-diagram"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-flex">
                <div>
                    <div class="card-title">Problèmes récents</div>
                    <div class="card-subtitle">10 derniers problèmes consolidés</div>
                </div>
                <a href="{{ path('app_problem_index') }}" class="btn btn-outline btn-sm">Voir tout</a>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Nom</th><th>Projet</th><th>Statut</th><th>Progression</th><th></th></tr>
                    </thead>
                    <tbody>
                        {% for p in problems %}
                            <tr>
                                <td class="fw-semibold">{{ p.name }}</td>
                                <td><span class="text-secondary">{{ p.project.name }}</span></td>
                                <td>
                                    {% set cls = {'draft':'badge-warning','computing':'badge-info','done':'badge-success','failed':'badge-danger'} %}
                                    <span class="badge-custom {{ cls[p.status] ?? 'badge-info' }}">{{ p.status }}</span>
                                </td>
                                <td style="min-width: 140px;">
                                    <div class="progress"><div class="progress-bar" style="width: {{ p.progress }}%;"></div></div>
                                    <small class="text-muted">{{ p.progress }}%</small>
                                </td>
                                <td><a class="btn-outline btn btn-sm" href="{{ path('app_problem_show', {id: p.id}) }}"><i class="fas fa-eye"></i></a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center py-4 text-secondary"><i class="fas fa-inbox fa-2x mb-2"></i><br>Aucun problème pour l'instant</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header-flex">
                <div>
                    <div class="card-title">Derniers résultats MCDM</div>
                    <div class="card-subtitle">Rangements TOPSIS / VIKOR / PROMETHEE II / ELECTRE I</div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Problème</th><th>Méthode</th><th>Top-1 recommandé</th><th>Choisi</th><th>Date</th></tr></thead>
                    <tbody>
                        {% for m in mcdm %}
                            <tr>
                                <td>{{ m.problem.name }}</td>
                                <td><span class="badge-custom badge-info">{{ m.method|upper }}</span></td>
                                <td>Solution #{{ m.recommendedSolutionId ?? '-' }}</td>
                                <td>{% if m.chosen %}<span class="badge-custom badge-success">Validé</span>{% else %}—{% endif %}</td>
                                <td>{{ m.createdAt|date('d/m/Y H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center text-secondary py-4">Aucun calcul MCDM effectué</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header-flex">
                <div>
                    <div class="card-title">Projets</div>
                    <div class="card-subtitle">Accès rapide</div>
                </div>
                <a href="{{ path('app_project_index') }}" class="btn btn-outline btn-sm">Voir tout</a>
            </div>
            {% for project in projects %}
                <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom: 1px solid var(--border-color);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="user-avatar" style="width: 40px; height: 40px;">{{ project.name|first|upper }}</div>
                        <div>
                            <div class="fw-semibold">{{ project.name }}</div>
                            <small class="text-muted">{{ project.problems|length }} problème(s)</small>
                        </div>
                    </div>
                    <a href="{{ path('app_project_show', {id: project.id}) }}" class="icon-btn"><i class="fas fa-arrow-right"></i></a>
                </div>
            {% else %}
                <div class="text-center py-4 text-secondary"><i class="fas fa-folder fa-2x mb-2"></i><br>Aucun projet</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
