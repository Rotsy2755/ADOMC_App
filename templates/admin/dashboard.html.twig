{% extends 'base.html.twig' %}

{% block title %}Administration — ADOMC{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="stat-label">Utilisateurs</div>
            <div class="stat-value">{{ stats.users }}</div>
            <div class="stat-change positive"><i class="fas fa-users"></i> enregistrés</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="stat-label">Projets</div>
            <div class="stat-value" style="color: var(--accent-cyan);">{{ stats.projects }}</div>
            <div class="stat-change positive"><i class="fas fa-folder-tree"></i> tous utilisateurs</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="stat-label">Problèmes MOKP</div>
            <div class="stat-value" style="color: var(--accent-success);">{{ stats.problems }}</div>
            <div class="stat-change positive"><i class="fas fa-puzzle-piece"></i> tous utilisateurs</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="stat-label">Calculs MCDM</div>
            <div class="stat-value" style="color: var(--accent-purple);">{{ stats.results }}</div>
            <div class="stat-change positive"><i class="fas fa-layer-group"></i> TOPSIS/VIKOR/...</div>
        </div>
    </div>
</div>

<div class="dashboard-card mb-4">
    <div class="card-header-flex">
        <div>
            <div class="card-title"><i class="fas fa-user-shield"></i> Gestion des utilisateurs</div>
            <div class="card-subtitle">Activer / désactiver les comptes et attribuer les rôles administrateur.</div>
        </div>
        <a href="{{ path('app_admin_users') }}" class="btn btn-primary btn-sm"><i class="fas fa-users"></i> Accéder</a>
    </div>
</div>

<div class="dashboard-card">
    <div class="card-header-flex">
        <div>
            <div class="card-title"><i class="fas fa-scroll"></i> Derniers événements d'audit</div>
            <div class="card-subtitle">20 dernières actions enregistrées (login, création, calcul, partage).</div>
        </div>
        <a href="{{ path('app_audit_index') }}" class="btn btn-outline btn-sm"><i class="fas fa-filter"></i> Filtres avancés</a>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Action</th><th>Utilisateur</th><th>Entité</th><th>IP</th></tr></thead>
            <tbody>
                {% for l in recentLogs %}
                    <tr>
                        <td><small>{{ l.createdAt|date('d/m/Y H:i:s') }}</small></td>
                        <td><span class="badge-custom badge-info">{{ l.action }}</span></td>
                        <td>{{ l.userEmail ?? '—' }}</td>
                        <td><small>{{ l.entityType ?? '—' }}#{{ l.entityId ?? '' }}</small></td>
                        <td><small><code>{{ l.ipAddress ?? '—' }}</code></small></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-secondary py-4">Aucun événement</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
