<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport ADOMC — {{ problem.name }}</title>
    <style>
        @page { margin: 18mm 14mm; }
        body { font-family: DejaVu Sans, sans-serif; color: #222; font-size: 10.5pt; }
        h1 { color: #1e293b; font-size: 20pt; margin-bottom: 0; }
        h2 { color: #1e40af; font-size: 14pt; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-top: 24px; }
        h3 { color: #334155; font-size: 12pt; margin-top: 14px; }
        table { border-collapse: collapse; width: 100%; margin-top: 6px; font-size: 9pt; }
        th, td { border: 1px solid #cbd5e1; padding: 5px 7px; text-align: left; }
        th { background: #e0e7ff; color: #1e293b; }
        .muted { color: #64748b; font-size: 9pt; }
        .header-info { margin-bottom: 18px; }
        .pill { display: inline-block; background: #e0e7ff; color: #1e40af; padding: 2px 8px; border-radius: 8px; font-size: 9pt; }
        .success { color: #047857; }
        .warning { color: #b45309; }
    </style>
</head>
<body>
<h1>Rapport ADOMC — {{ problem.name }}</h1>
<div class="header-info">
    <div class="muted">
        Projet : <strong>{{ problem.project.name }}</strong> ·
        Généré le {{ generatedAt|date('d/m/Y H:i') }} ·
        Statut : <span class="pill">{{ problem.status }}</span>
    </div>
</div>

<h2>1. Description du problème</h2>
<table>
    <tr><th>Capacité</th><td>{{ problem.capacity }}</td></tr>
    <tr><th>Nombre d'articles (n)</th><td>{{ problem.items|length }}</td></tr>
    <tr><th>Nombre d'objectifs (p)</th><td>{{ problem.objectiveCount }}</td></tr>
    <tr><th>Objectifs</th><td>{% for o in problem.objectives %}f{{ loop.index }} — {{ o }}{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
    <tr><th>Algorithme</th><td>{{ problem.algorithm ?? '—' }}</td></tr>
    <tr><th>Flou (fuzzy)</th><td>{{ problem.fuzzyEnabled ? 'Activé' : 'Désactivé' }}</td></tr>
</table>

<h3>Articles</h3>
<table>
    <thead>
        <tr>
            <th>#</th><th>Nom</th><th>Poids</th>
            {% for o in problem.objectives %}<th>f{{ loop.index }}</th>{% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for it in problem.items %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ it.name }}</td>
                <td>{{ it.weight|number_format(2, '.', ' ') }}</td>
                {% for v in it.values %}<td>{{ v|number_format(2, '.', ' ') }}</td>{% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>

<h2>2. Front de Pareto ({{ solutions|length }} solutions)</h2>
{% if solutions|length == 0 %}
    <p class="muted">Aucune solution Pareto calculée.</p>
{% else %}
<table>
    <thead>
        <tr>
            <th>#</th><th>Poids total</th>
            {% for o in problem.objectives %}<th>f{{ loop.index }} — {{ o }}</th>{% endfor %}
            <th>Articles</th>
        </tr>
    </thead>
    <tbody>
        {% for s in solutions %}
            <tr>
                <td>#{{ s.id }}</td>
                <td>{{ s.totalWeight|number_format(2, '.', ' ') }}</td>
                {% for v in s.objectiveValues %}<td>{{ v|number_format(2, '.', ' ') }}</td>{% endfor %}
                <td>{{ s.selectedItemIds|join(', ') }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

<h2>3. Pondérations AHP</h2>
{% if ahpList|length == 0 %}
    <p class="muted">Aucune matrice AHP enregistrée.</p>
{% else %}
    {% for m in ahpList %}
        <h3>Scénario #{{ m.id }} — {{ m.label }}</h3>
        <div class="muted">
            CR = <strong class="{% if m.consistent %}success{% else %}warning{% endif %}">{{ m.cr|number_format(4, '.', ' ') }}</strong>
            · CI = {{ m.ci|number_format(4, '.', ' ') }}
            · λ<sub>max</sub> = {{ m.lambdaMax|number_format(4, '.', ' ') }}
            · enregistrée le {{ m.createdAt|date('d/m/Y H:i') }}
        </div>
        <table>
            <thead><tr><th>Critère</th><th>Poids λ</th></tr></thead>
            <tbody>
                {% for w in m.weights %}
                    <tr>
                        <td>f{{ loop.index }} — {{ problem.objectiveLabels[loop.index0] ?? '' }}</td>
                        <td>{{ w|number_format(4, '.', ' ') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endfor %}
{% endif %}

<h2>4. Résultats MCDM</h2>
{% if mcdmList|length == 0 %}
    <p class="muted">Aucun calcul MCDM.</p>
{% else %}
<table>
    <thead>
        <tr><th>#</th><th>Méthode</th><th>Norm.</th><th>Top-1</th><th>Validée</th><th>Date</th></tr>
    </thead>
    <tbody>
        {% for r in mcdmList %}
            <tr>
                <td>#{{ r.id }}</td>
                <td>{{ r.method|upper }}</td>
                <td>{{ r.normalization }}</td>
                <td>#{{ r.recommendedSolutionId ?? '-' }}</td>
                <td>{{ r.chosen ? 'Oui' : '—' }}</td>
                <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

<h2>5. Analyses de sensibilité</h2>
{% if sensList|length == 0 %}
    <p class="muted">Aucune analyse de sensibilité.</p>
{% else %}
<table>
    <thead><tr><th>#</th><th>Critère</th><th>Intervalle</th><th>Pas</th><th>Top-k</th><th>Résumé</th></tr></thead>
    <tbody>
        {% for a in sensList %}
            <tr>
                <td>#{{ a.id }}</td>
                <td>f{{ a.criterion + 1 }}</td>
                <td>[{{ a.minValue|number_format(2, '.', ' ') }} ; {{ a.maxValue|number_format(2, '.', ' ') }}]</td>
                <td>{{ a.step|number_format(2, '.', ' ') }}</td>
                <td>{{ a.topK }}</td>
                <td>{{ a.summary ?? '—' }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

<p class="muted" style="margin-top: 30px; text-align: center;">
    ADOMC — Aide à la Décision Multi-Objectifs et Multi-Critères · rapport généré automatiquement
</p>
</body>
</html>
