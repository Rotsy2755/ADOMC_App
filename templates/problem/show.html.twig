{% extends 'base.html.twig' %}
{% block title %}{{ problem.name }} — ADOMC{% endblock %}
{% block body %}
<div class="dashboard-card mb-4">
    <div class="card-header-flex">
        <div>
            <div class="card-title"><i class="fas fa-puzzle-piece"></i> {{ problem.name }}</div>
            <div class="card-subtitle">
                Projet <a href="{{ path('app_project_show', {id: problem.project.id}) }}">{{ problem.project.name }}</a>
                • {{ problem.items|length }} articles × {{ problem.objectiveCount }} objectifs
                • Capacité W = {{ problem.capacity }}
                {% if problem.fuzzyEnabled %}• <span class="badge-custom badge-info">Mode flou</span>{% endif %}
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_problem_edit', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-edit"></i> Éditer</a>
            <a href="{{ path('app_pareto_show', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-bezier-curve"></i> Pareto</a>
            <a href="{{ path('app_ahp_show', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-balance-scale"></i> AHP</a>
            <a href="{{ path('app_mcdm_show', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-layer-group"></i> MCDM</a>
            <a href="{{ path('app_sensitivity_show', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-sliders-h"></i> Sensibilité</a>
            <a href="{{ path('app_scenario_compare', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-columns"></i> Scénarios</a>
            <a href="{{ path('app_robustness_show', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-shield-alt"></i> Robustesse</a>
            <a href="{{ path('app_preference_suggest', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-magic"></i> Préférence</a>
            <a href="{{ path('app_export_pdf', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-file-pdf"></i> PDF</a>
            <a href="{{ path('app_export_csv', {id: problem.id}) }}" class="btn btn-outline"><i class="fas fa-file-csv"></i> CSV</a>
        </div>
    </div>
    {% if problem.description %}<p class="text-secondary">{{ problem.description|nl2br }}</p>{% endif %}
    <div class="mt-3">
        <span class="text-muted">Statut :</span>
        {% set cls = {'draft':'badge-warning','computing':'badge-info','done':'badge-success','failed':'badge-danger'} %}
        <span class="badge-custom {{ cls[problem.status] ?? 'badge-info' }}">{{ problem.status }}</span>
        <span class="text-muted ms-3">Algorithme :</span> {{ problem.algorithm ?? '—' }}
        <div class="progress mt-2" style="max-width:300px;"><div class="progress-bar" id="progress-bar" style="width: {{ problem.progress }}%;"></div></div>
        <small class="text-muted"><span id="progress-value">{{ problem.progress }}</span>%</small>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="dashboard-card">
            <div class="card-header-flex">
                <div>
                    <div class="card-title">Données du problème</div>
                    <div class="card-subtitle">Objectifs : {{ problem.objectives|join(', ') }}</div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Article</th>
                            <th>w</th>
                            {% for label in problem.objectives %}<th>{{ label }}</th>{% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for it in problem.items %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ it.name }}</td>
                                <td>{{ it.weight }}</td>
                                {% for v in it.values %}<td>{{ v }}</td>{% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="dashboard-card">
            <div class="card-header-flex">
                <div><div class="card-title">Calcul du front de Pareto</div><div class="card-subtitle">ε-contrainte (exact, n ≤ 40) ou NSGA-II (méta-heuristique)</div></div>
            </div>
            <form method="post" action="{{ path('app_problem_compute', {id: problem.id}) }}" class="row g-3">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('problem_compute_' ~ problem.id) }}">
                <div class="col-md-6">
                    <label class="form-label">Algorithme</label>
                    <select name="algorithm" class="form-select">
                        <option value="epsilon" {{ problem.items|length <= 40 ? '' : 'disabled' }}>ε-contrainte (exact)</option>
                        <option value="nsga2">NSGA-II (méta-heuristique)</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-primary w-100"><i class="fas fa-play"></i> Lancer le calcul</button>
                </div>
            </form>
        </div>

        <div class="dashboard-card mt-3">
            <div class="card-header-flex">
                <div><div class="card-title">Partager</div><div class="card-subtitle">Lien public signé SHA-256</div></div>
            </div>
            <form method="post" action="{{ path('app_share_new', {id: problem.id}) }}" class="row g-3">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('share_new_' ~ problem.id) }}">
                <div class="col-md-6">
                    <label class="form-label">Durée (jours)</label>
                    <input type="number" name="expires_days" min="1" max="365" value="30" class="form-control">
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-outline w-100"><i class="fas fa-share-alt"></i> Créer le lien</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% if problem.snapshots|length > 0 %}
<div class="dashboard-card mt-4">
    <div class="card-header-flex"><div><div class="card-title">Historique des versions</div><div class="card-subtitle">{{ problem.snapshots|length }} snapshot(s)</div></div></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Motif</th><th>Auteur</th></tr></thead>
            <tbody>
                {% for s in problem.snapshots %}
                    <tr><td>{{ s.createdAt|date('d/m/Y H:i:s') }}</td><td>{{ s.reason }}</td><td>{{ s.author.email ?? '—' }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function(){
    if ({{ problem.status == 'computing' ? 'true' : 'false' }}) {
        const bar = document.getElementById('progress-bar');
        const val = document.getElementById('progress-value');
        const poll = () => {
            fetch('{{ path('app_problem_progress', {id: problem.id}) }}', {credentials:'same-origin'})
                .then(r => r.json())
                .then(d => {
                    bar.style.width = d.progress + '%';
                    val.textContent = d.progress;
                    if (d.status === 'done' || d.status === 'failed') {
                        window.location.reload();
                    } else {
                        setTimeout(poll, 2000);
                    }
                }).catch(() => setTimeout(poll, 5000));
        };
        setTimeout(poll, 2000);
    }
})();
</script>
{% endblock %}
