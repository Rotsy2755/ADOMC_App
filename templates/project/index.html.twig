{% extends 'base.html.twig' %}
{% block title %}Projets — ADOMC{% endblock %}
{% block body %}
<div class="dashboard-card mb-4">
    <div class="card-header-flex">
        <div>
            <div class="card-title"><i class="fas fa-folder-tree"></i> Mes projets</div>
            <div class="card-subtitle">{{ projects|length }} projet(s)</div>
        </div>
        <a href="{{ path('app_project_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i> Nouveau projet</a>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Nom</th><th>Description</th><th>Problèmes</th><th>Maj</th><th></th></tr></thead>
            <tbody>
                {% for p in projects %}
                    <tr>
                        <td class="fw-semibold">{{ p.name }}</td>
                        <td class="text-secondary">{{ p.description|u.truncate(80, '…') ?? '—' }}</td>
                        <td>{{ p.problems|length }}</td>
                        <td>{{ p.updatedAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <a href="{{ path('app_project_show', {id: p.id}) }}" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('app_project_edit', {id: p.id}) }}" class="btn btn-outline btn-sm"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('app_project_delete', {id: p.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce projet et tous ses problèmes ?');">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('project_delete_' ~ p.id) }}">
                                <button class="btn btn-outline btn-sm" style="color: var(--accent-danger);"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center py-4 text-secondary"><i class="fas fa-inbox fa-2x mb-2"></i><br>Aucun projet, créez-en un !</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
