<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — ADOMC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        .brand {
            text-align: center;
            margin-bottom: 30px;
        }
        .brand i {
            font-size: 48px;
            color: #3b82f6;
        }
        .brand h2 {
            color: #f8fafc;
            margin-top: 15px;
        }
        .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid #334155;
            color: #f8fafc;
        }
        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #3b82f6;
            color: #f8fafc;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }
        .btn-primary {
            background-color: #3b82f6;
            border-color: #3b82f6;
            width: 100%;
            padding: 12px;
        }
        .btn-primary:hover {
            background-color: #2563eb;
            border-color: #2563eb;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <img src="/images/admin-avatar.png" alt="Admin" style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid #3b82f6; margin-bottom: 10px; box-shadow: 0 0 0 5px rgba(59,130,246,0.15), 0 0 20px rgba(59,130,246,0.4); transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='scale(1.08)';this.style.boxShadow='0 0 0 6px rgba(59,130,246,0.2), 0 0 30px rgba(59,130,246,0.6)';" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 0 0 5px rgba(59,130,246,0.15), 0 0 20px rgba(59,130,246,0.4)';">
            <div style="color: #f8fafc; font-weight: 600; font-size: 15px; margin-bottom: 4px;">ADOMC</div>
            <h2>Aide à la Décision</h2>
            <p class="text-secondary">Multi-Objectifs &amp; Multi-Critères</p>
        </div>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="inputEmail" class="form-label text-light">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
            </div>
            <div class="mb-4">
                <label for="inputPassword" class="form-label text-light">Mot de passe</label>
                <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary" type="submit">
                <i class="fas fa-sign-in-alt"></i> Connexion
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="{{ path('app_register') }}" style="color: #3b82f6;"><i class="fas fa-user-plus"></i> Créer un compte</a>
        </div>

    </div>
</body>
</html>
